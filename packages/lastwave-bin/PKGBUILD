# Maintainer: adttsonaisse <adttsonaisse@users.noreply.github.com>
# Repack dari .deb upstream. Tidak memakai debtap dan tidak build dari source.

pkgname=lastwave-bin
pkgver=2.5.0
pkgrel=1
pkgdesc='Simple Desktop YouTube Music client with WinUI, Bit-Perfect playback, Automix, and Lossless addons (repack dari .deb resmi)'
arch=('x86_64')
url='https://github.com/Clash-Projects/LastWave-Desktop'
license=('LicenseRef-proprietary')
provides=('lastwave')
conflicts=('lastwave' 'lastwave-desktop')
depends=(
  'gtk3'
  'webkit2gtk-4.1'
  'libayatana-appindicator'
  'alsa-lib'
  'mpv'
  'libkeybinder3'
  'libsecret'
  'glib-networking'
  'xdg-utils'
  'hicolor-icon-theme'
)
options=('!strip' '!debug')
noextract=("lastwave_${pkgver}_amd64.deb")
source=("lastwave_2.5.0_amd64.deb::https://github.com/Clash-Projects/LastWave-Desktop/releases/download/v2.5.0/lastwave_2.5.0_amd64.deb")
sha256sums=('dc4149fac2db1c109fd7980129da40852407bcf67b93a446f0d270b325516b5b')

_deb="lastwave_${pkgver}_amd64.deb"

prepare() {
  cd "$srcdir"

  # File .deb adalah arsip ar. Keluarkan control.tar.* dan data.tar.*
  bsdtar -xf "$_deb"
}

package() {
  cd "$srcdir"

  if ! compgen -G 'data.tar.*' > /dev/null; then
    echo 'data.tar.* tidak ditemukan setelah ekstraksi .deb' >&2
    return 1
  fi

  # Isi data.tar.* langsung dipindahkan ke pkgdir
  bsdtar -xf data.tar.* -C "$pkgdir"

  # Semua direktori bisa dibaca/dilalui
  find "$pkgdir" -type d -exec chmod 755 {} +

  # File yang di .deb memang ber-execute bit: pertahankan execute bit-nya
  find "$pkgdir" -type f -perm /111 -exec chmod a+x {} +

  # Shared library ikut perlu +x supaya dlopen bekerja
  find "$pkgdir" -type f \( -name '*.so' -o -name '*.so.*' \) -exec chmod a+x {} +

  # .desktop dan aset data tidak boleh executable
  find "$pkgdir" -type f \( -name '*.desktop' -o -name '*.png' -o -name '*.svg' -o -name '*.json' -o -name '*.ico' -o -name '*.html' -o -name '*.frag' -o -name '*.dat' \) -exec chmod 644 {} +

  # Entry point di /usr/bin wajib executable. Symlink tidak terkena -type f,
  # jadi targetnya yang sudah diurus pada langkah sebelumnya.
  if [[ -d "$pkgdir/usr/bin" ]]; then
    find "$pkgdir/usr/bin" -type f -exec chmod 755 {} +
  fi
}
