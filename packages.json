[
  {
    "pkgname": "openmausbot-bin",
    "dir": "packages/openmausbot-bin",
    "upstream": "milind-soni/OpenMausBot",
    "asset_regex": "^OpenMausBot-.*-amd64[.]deb$",
    "version_sed": "s/^OpenMausBot-(.*)-amd64\\.deb$/\\1/",
    "deb_name_template": "OpenMausBot-{version}-amd64.deb"
  },
  {
    "pkgname": "lastwave-bin",
    "dir": "packages/lastwave-bin",
    "upstream": "Clash-Projects/LastWave-Desktop",
    "asset_regex": "^lastwave_.*_amd64[.]deb$",
    "version_sed": "s/^lastwave_(.*)_amd64\\.deb$/\\1/",
    "deb_name_template": "lastwave_{version}_amd64.deb"
  }
]
